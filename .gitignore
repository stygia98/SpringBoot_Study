# =========================================================================
# 1. 자바 컴파일 및 빌드 결과물 (Compiled Class & Packaged Files)
# =========================================================================
*.class
*.log
*.ctxt

# 패키지 및 압축 파일 (빌드 산출물)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# 빌드 디렉터리 (공통 및 도구별)
target/
/target/
bin/
out/
/out/
build/
/build/
/dist/
/nbbuild/
/nbdist/

# =========================================================================
# 2. 크래시 리포트 및 로그 / 임시 파일 (Logs & Temp Files)
# =========================================================================
*.log.*
log/
logs/
hs_err_pid*
replay_pid*
*.coredump
.help/

# =========================================================================
# 3. 데이터베이스 관련 (로컬 테스트용 내장 DB)
# =========================================================================
*.mv.db
*.trace.db
*.db

# =========================================================================
# 4. 빌드 도구 및 래퍼 설정 (Build Tools & Wrappers)
# =========================================================================
# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Gradle
.gradle/
.core/
/captures/

# [중요] 래퍼 파일은 협업 및 빌드 서버를 위해 Git이 추적하도록 예외(!) 처리
!gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# =========================================================================
